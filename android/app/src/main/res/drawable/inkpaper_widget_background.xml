<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃质感小部件背景（参考首页底部新增笔记栏）：
     RemoteViews 不支持实时模糊（Android 12 的 window blur 只对
     Activity/Dialog 窗口生效，widget 运行在 launcher 进程拿不到 Window），
     用「半透明底 + 斜向高光渐变 + 暗边」三层手绘逼近 LiquidGlass 的
     tint / glint / 暗边观感。明暗色值由 values / values-night 提供。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 玻璃底色：半透明，让壁纸颜色微微透过来 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/inkpaper_widget_background" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- 高光：左上到右下的斜向反光，模拟玻璃 glint -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/inkpaper_widget_highlight_start"
                android:endColor="@color/inkpaper_widget_highlight_end" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- 暗边：LiquidGlass 的 darkened rim -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/inkpaper_widget_border" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
