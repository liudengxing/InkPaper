<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃芯片：半透明底 + 细暗边，圆角取小部件内视图档位（背景 22dp − 8dp） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/inkpaper_widget_surface" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/inkpaper_widget_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
