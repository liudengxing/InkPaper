<?xml version="1.0" encoding="utf-8"?>
<!-- 随机回顾 · 4×2 横条。
     信息层级参考 flomo 每日回顾小组件，自上而下三层：
       1. 语境标签（去年今日 / 3 天前）+「换一条」—— 说清这条来自多久以前
       2. 正文 —— 主视觉，行距放宽；超长时可上下滚动
       3. 时间 · 标签 + 品牌落款 —— 最弱的一层，只做定位
     玻璃沿用 inkpaper_widget_background（手绘 5 层兜底），
     拿得到壁纸时再铺 WallpaperGlass 烘焙的模糊位图。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inkpaper_widget_glass_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/inkpaper_widget_background">

    <ImageView
        android:id="@+id/inkpaper_widget_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/inkpaper_widget_review_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="11dp">

        <!-- 顶部行：左「多久以前」，右「换一条」。整块点击由 container 的
             PendingIntent 负责打开当前这条笔记，按钮只负责换下一条 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/inkpaper_widget_age"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="去年今日"
                android:textColor="@color/inkpaper_widget_accent"
                android:textSize="11.5sp" />

            <ImageButton
                android:id="@+id/inkpaper_widget_shuffle"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@android:color/transparent"
                android:contentDescription="换一条"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_shuffle"
                android:tint="@color/inkpaper_widget_muted" />
        </LinearLayout>

        <!-- 单行长条目：条目高度由文本撑开，超出小部件可视区时 ListView 可上下滚动
             （RemoteViews 里 ScrollView / TextView 都不支持滚动，集合视图是唯一解） -->
        <ListView
            android:id="@+id/inkpaper_widget_review_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="7dp"
            android:layout_weight="1"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:requiresFadingEdge="none"
            android:scrollbars="none" />

        <!-- 底部行：时间 · 标签（弱） + 品牌落款（最弱） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/inkpaper_widget_review_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="2026-11-14 08:30"
                android:textColor="@color/inkpaper_widget_muted"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/inkpaper_widget_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:text="InkPaper"
                android:textColor="@color/inkpaper_widget_brand"
                android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
