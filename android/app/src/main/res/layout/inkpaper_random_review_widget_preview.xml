<?xml version="1.0" encoding="utf-8"?>
<!-- 「小组件」选择器里的静态预览图（Android 12+ 的 previewLayout /
     添加瞬间的 initialLayout 都用它）：运行时布局的预览区是 ListView，
     选择器里渲染不出来内容，所以这里用同款静态版当预览。
     三层结构与运行时一致：语境标签 → 正文 → 时间 · 品牌。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inkpaper_widget_review_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/inkpaper_widget_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/inkpaper_widget_age"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="去年今日"
            android:textColor="@color/inkpaper_widget_accent"
            android:textSize="11.5sp" />

        <ImageButton
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_shuffle"
            android:tint="@color/inkpaper_widget_muted" />
    </LinearLayout>

    <TextView
        android:id="@+id/inkpaper_widget_review"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:maxLines="4"
        android:text="上周整理的那条 JVM 笔记：逃逸分析决定对象是栈上分配还是堆分配……"
        android:textColor="@color/inkpaper_widget_text"
        android:textSize="14.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/inkpaper_widget_review_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="2026-11-14 08:30 · #JVM"
            android:textColor="@color/inkpaper_widget_muted"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/inkpaper_widget_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="InkPaper"
            android:textColor="@color/inkpaper_widget_brand"
            android:textSize="9.5sp" />
    </LinearLayout>
</LinearLayout>
