<?xml version="1.0" encoding="utf-8"?>
<!-- 「小组件」选择器里的静态预览图（Android 12+ 的 previewLayout /
     添加瞬间的 initialLayout 都用它）：运行时布局的预览区是 ListView，
     选择器里渲染不出来内容，所以这里用同款静态版当预览 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inkpaper_widget_review_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/inkpaper_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/inkpaper_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="随机回顾"
            android:textColor="@color/inkpaper_widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/inkpaper_widget_random"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/inkpaper_widget_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="56dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="打开"
            android:textColor="@color/inkpaper_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/inkpaper_widget_review"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="5"
        android:text="上周整理的那条 JVM 笔记：逃逸分析决定对象是栈上分配还是堆分配……"
        android:textColor="@color/inkpaper_widget_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/inkpaper_widget_review_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="2026-11-14 08:30"
        android:textColor="@color/inkpaper_widget_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/inkpaper_widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="1小时刷新 · 全部"
        android:textColor="@color/inkpaper_widget_muted"
        android:textSize="11sp" />
</LinearLayout>
