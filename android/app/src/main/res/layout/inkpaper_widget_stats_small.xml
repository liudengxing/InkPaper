<?xml version="1.0" encoding="utf-8"?>
<!-- 周统计 / 周趋势 · 2×2。
     2×2 只有 110dp，装不下标题副文案，只留「本周 + 总数」和图表。
     图表是 Kotlin 侧用 Canvas 画的一张位图（格子或柱状），
     不把七个格子拆成七个 View —— 月统计要放 30+ 格，堆 View 会拖慢 launcher。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inkpaper_widget_glass_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/inkpaper_widget_background">

    <ImageView
        android:id="@+id/inkpaper_widget_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="11dp"
        android:paddingEnd="13dp"
        android:paddingBottom="11dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/inkpaper_widget_stats_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="本周"
                android:textColor="@color/inkpaper_widget_accent"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/inkpaper_widget_stats_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0 条"
                android:textColor="@color/inkpaper_widget_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/inkpaper_widget_stats_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="7dp"
            android:layout_weight="1"
            android:contentDescription="记录分布图"
            android:scaleType="fitXY" />
    </LinearLayout>
</FrameLayout>
