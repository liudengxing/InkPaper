<?xml version="1.0" encoding="utf-8"?>
<!-- 月统计 / 月趋势 · 4×2。
     比 2×2 多一行底部信息（有记录的天数 + 品牌落款），
     图表区放得下整月的格子墙或 30 根柱状。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inkpaper_widget_glass_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/inkpaper_widget_background">

    <ImageView
        android:id="@+id/inkpaper_widget_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="11dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/inkpaper_widget_stats_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="本月"
                android:textColor="@color/inkpaper_widget_accent"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/inkpaper_widget_stats_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0 条"
                android:textColor="@color/inkpaper_widget_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/inkpaper_widget_stats_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="7dp"
            android:layout_weight="1"
            android:contentDescription="记录分布图"
            android:scaleType="fitXY" />

        <!-- 底部只留品牌落款：4×2 高度紧张，有记录的天数已经并进右上角那行，
             再单起一行说明会把图表压到 40dp 以下 -->
        <TextView
            android:id="@+id/inkpaper_widget_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="end"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="InkPaper"
            android:textColor="@color/inkpaper_widget_brand"
            android:textSize="9.5sp" />
    </LinearLayout>
</FrameLayout>
