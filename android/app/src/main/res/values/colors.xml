<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 自适应图标底色：墨绿满底，前景为白色折角纸页 -->
    <color name="ic_launcher_background">#21473D</color>
    <!-- 启动图底色：明暗主题共用同一张墨绿底图，这里是它的纯色版，
         用作窗口在图片加载前、以及图片未覆盖区域的颜色 -->
    <color name="splash_brand">#143B30</color>
    <color name="splash_color">#143B30</color>
    <color name="splash_color_dark">#143B30</color>
    <color name="inkpaper_primary">#2C9678</color>
    <!-- 桌面小部件玻璃质感：半透明底 + 垂直高光 + 双层描边（外暗边 + 内亮边）。
         RemoteViews 拿不到实时模糊（launcher 进程拿不到 Window，且 HyperOS
         拒绝第三方读壁纸，权限路径被商店政策堵死），玻璃感只能靠「壁纸透出来
         + 边界光」模拟 —— 所以底色不透明度必须够低，否则就是一块白板。 -->
    <color name="inkpaper_widget_background">#99FFFFFF</color>
    <color name="inkpaper_widget_surface">#8CFFFFFF</color>
    <color name="inkpaper_widget_text">#1F2A27</color>
    <color name="inkpaper_widget_muted">#4F5A55</color>
    <color name="inkpaper_widget_border">#38000000</color>
    <color name="inkpaper_widget_rim">#2EFFFFFF</color>
    <color name="inkpaper_widget_highlight_start">#2EFFFFFF</color>
    <color name="inkpaper_widget_highlight_end">#00FFFFFF</color>
    <!-- 顶部边缘光泽：叠在全高渐变之上做出「上缘反光」，底部保留微量
         提亮形成玻璃厚度感。iOS 毛玻璃最强的视觉线索就是这道边缘光 -->
    <color name="inkpaper_widget_sheen_start">#5CFFFFFF</color>
    <color name="inkpaper_widget_sheen_end">#14FFFFFF</color>
    <!-- 小部件强调色（按钮文字等）：中性灰，用户 2026-11-14 要求
         随机回顾小部件的主题色从品牌绿改成灰 -->
    <color name="inkpaper_widget_accent">#4A544F</color>
    <!-- 真玻璃背景（壁纸模糊位图）的叠色：按系统明暗在 Kotlin 里显式取用，
         不走 values-night 自动解析 —— 小部件位图在 App 进程烘焙，
         App 自身主题可能与系统不一致，必须以系统明暗为准 -->
    <color name="inkpaper_widget_glass_tint">#A8FFFFFF</color>
    <color name="inkpaper_widget_glass_highlight_start">#66FFFFFF</color>
    <color name="inkpaper_widget_glass_highlight_end">#0DFFFFFF</color>
    <color name="inkpaper_widget_glass_border">#2E000000</color>
    <color name="inkpaper_widget_glass_tint_night">#A8FFFFFF</color>
    <color name="inkpaper_widget_glass_highlight_start_night">#66FFFFFF</color>
    <color name="inkpaper_widget_glass_highlight_end_night">#0DFFFFFF</color>
    <color name="inkpaper_widget_glass_border_night">#2E000000</color>
</resources>
